# ============================================================================
# Da Pizza Hub — Environment Variables
# ============================================================================
# 1. SUPABASE / POSTGRES (Auto-added on Vercel when you connect your Supabase
#    database in Vercel Dashboard -> Storage -> Connect Project — NO manual
#    copy-paste needed on Vercel!)
# ============================================================================
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ============================================================================
# 2. ADMIN PANEL (/admin/login) — Required for staff access
#    Set your own custom staff password here or in Vercel:
#    Add ADMIN_PASSWORD in Vercel -> Project Settings -> Environment Variables
# ============================================================================
ADMIN_PASSWORD=your_custom_password_here

# ============================================================================
# 3. WHATSAPP — Optional Override
#    By default, WhatsApp order receipts & inquiries automatically use each
#    branch's WhatsApp number stored in Supabase (`branches.whatsapp`), which
#    you can edit anytime from Admin Panel -> Branches (/admin/branches).
#    Only set NEXT_PUBLIC_WHATSAPP_NUMBER (format: 919876543210) if you want
#    to force all general WhatsApp buttons to one master number.
# ============================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=
